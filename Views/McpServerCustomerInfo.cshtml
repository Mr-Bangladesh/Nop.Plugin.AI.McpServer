
@model Nop.Plugin.AI.McpServer.Models.PersonalAccessTokenModel

<div id="mcpserver-token-container">
	<form id="mcpserver-token-form">
		@Html.AntiForgeryToken()
	</form>

	<div>
		<strong>Your PAT:</strong>
		<span id="mcpserver-masked">@Model.Masked</span>
	</div>

	<div style="margin-top:8px;">
		<button id="mcpserver-generate-btn" class="btn btn-primary">@(Model.HasToken ? "Regenerate" : "Generate")</button>
		<button id="mcpserver-copy-btn" class="btn btn-secondary" style="margin-left:8px;">Copy</button>
	</div>

	<div id="mcpserver-plain-section" style="display:none; margin-top:8px;">
		<label>Copy this token now (shown only once):</label>
		<input type="text" id="mcpserver-plain-token" readonly style="width:100%;" />
	</div>
</div>

<script>
	(function(){
		var generateBtn = document.getElementById('mcpserver-generate-btn');
		var copyBtn = document.getElementById('mcpserver-copy-btn');
		var maskedEl = document.getElementById('mcpserver-masked');
		var plainSection = document.getElementById('mcpserver-plain-section');
		var plainInput = document.getElementById('mcpserver-plain-token');
		var plainToken = null;

		function getAntiForgeryToken(){
			var tokenInput = document.querySelector('#mcpserver-token-form input[name="__RequestVerificationToken"]');
			return tokenInput ? tokenInput.value : '';
		}

		generateBtn.addEventListener('click', function(e){
			e.preventDefault();
			var token = getAntiForgeryToken();
			var url = '@Url.Action("GenerateToken", "McpServerPublic", new { area = "" })';
			fetch(url, {
				method: 'POST',
				headers: {
					'RequestVerificationToken': token,
					'Accept': 'application/json'
				},
				credentials: 'same-origin'
			}).then(function(r){ return r.json(); }).then(function(json){
				if(json && json.success){
					plainToken = json.token || null;
					plainInput.value = plainToken || '';
					if(plainToken){
						plainSection.style.display = 'block';
					}
					maskedEl.textContent = json.masked || maskedEl.textContent;
					generateBtn.textContent = 'Regenerate';
				} else {
					alert((json && json.message) || 'Failed to generate token');
				}
			}).catch(function(){
				alert('Failed to generate token');
			});
		});

		copyBtn.addEventListener('click', function(e){
			e.preventDefault();
			var toCopy = plainToken || maskedEl.textContent || '';
			if(!toCopy) return;
			if(navigator.clipboard && navigator.clipboard.writeText){
				navigator.clipboard.writeText(toCopy).then(function(){
					alert('Copied to clipboard');
				}).catch(function(){
					alert('Copy failed');
				});
			} else {
				plainInput.select();
				try { document.execCommand('copy'); alert('Copied to clipboard'); } catch(e){ alert('Copy failed'); }
			}
		});
	})();
</script>
